# Copy this file to `.env` and fill in your Connect Open API credentials.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit it, never paste real values here, and
# never paste real values into a bug report.
#
# Every variable below is also settable as a real environment variable, and a
# real environment variable always wins over this file. That is the right way
# to supply secrets in production: use your platform's secret store and never
# write a .env file to disk at all.

# --- Required ---------------------------------------------------------------

# Client id from the Spotware Connect app registration.
CONNECT_CLIENT_ID=

# Client secret from the Spotware Connect app registration. Treat as a
# password: never commit it, never log it.
CONNECT_CLIENT_SECRET=

# Access token issued for the trading account.
CONNECT_ACCESS_TOKEN=

# Trading account id, as a positive whole number.
CONNECT_ACCOUNT_ID=

# --- Optional ---------------------------------------------------------------

# API endpoint. Must be a bare hostname: no scheme, no port, no path.
# Default: sandbox-tradeapi.spotware.com
# CONNECT_HOST=sandbox-tradeapi.spotware.com

# TLS port. Default: 5032
# CONNECT_PORT=5032

# Symbol to subscribe to. Default: EURUSD
# CONNECT_SYMBOL=EURUSD

# Keep-alive ping interval in milliseconds (100-600000). Default: 1000
# CONNECT_PING_INTERVAL_MS=1000

# Log verbosity: debug, info, warn, error or silent. Default: info
# LOG_LEVEL=info

# Path to this file, relative to the working directory. Default: .env
# Useful in containers, where the file is mounted somewhere other than /app.
# CONNECT_ENV_FILE=.env
