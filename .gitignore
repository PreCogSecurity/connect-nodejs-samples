# Local environment / secrets.
# A .env file holds plaintext credentials. It must never be committed.
# Only .env.example (the template with no real values) is tracked.
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# https://www.npmjs.com/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

# Editor noise
.idea
.vscode
*.swp
.DS_Store
node_modules/
